{
  "entities": {
    "News": {
      "title": "News Article",
      "description": "A news article for the mandate portal.",
      "type": "object",
      "properties": {
        "title": { "type": "string", "description": "Headline of the news." },
        "date": { "type": "string", "description": "Publication date." },
        "excerpt": { "type": "string", "description": "Short summary." },
        "category": { "type": "string", "description": "Category (e.g., Segurança, Agro)." },
        "image": { "type": "string", "description": "URL of the cover image." },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "date", "excerpt", "category", "image"]
    },
    "Video": {
      "title": "Video",
      "description": "A video for the gallery.",
      "type": "object",
      "properties": {
        "title": { "type": "string", "description": "Title of the video." },
        "url": { "type": "string", "description": "YouTube/Vimeo URL." },
        "thumbnail": { "type": "string", "description": "Thumbnail image URL." },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "url", "thumbnail"]
    },
    "DriveLink": {
      "title": "Drive Link",
      "description": "A link to a Google Drive folder or file.",
      "type": "object",
      "properties": {
        "key": { "type": "string", "description": "Unique identifier (e.g., 'panfletos')." },
        "label": { "type": "string", "description": "Display name." },
        "url": { "type": "string", "description": "Google Drive URL." }
      },
      "required": ["key", "label", "url"]
    }
  },
  "firestore": {
    "/news": { "schema": "News", "description": "Collection of news articles." },
    "/videos": { "schema": "Video", "description": "Collection of videos." },
    "/driveLinks": { "schema": "DriveLink", "description": "Collection of managed Google Drive links." }
  }
}
